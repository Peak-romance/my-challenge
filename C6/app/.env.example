# =====================================================
# 公共资产闲置平台 —— 环境变量示例
# -----------------------------------------------------
# 适用场景：免 Docker 本地直跑（start.bat / start.sh）
#   cp .env.example .env
# Docker 场景无需此文件：docker-compose.yml 已内置容器内路径并挂载卷，
# 若放置 .env 反而会用本地路径覆盖容器路径，请勿在 Docker 场景复制本文件。
#
# 路径规则：填相对路径时相对于「仓库根目录」解析；绝对路径按原样使用。
# =====================================================

# ---- 数据库：SQLite 单文件 ----
DATABASE_PATH=database/data/app.db

# ---- 图片本地存储目录（原图 + 水印图） ----
UPLOAD_DIR=database/data/uploads

# ---- 会话 / JWT 密钥（生产环境务必修改！） ----
SECRET_KEY=public-asset-idle-platform-dev-secret
JWT_ALGORITHM=HS256
# 登录有效期（小时）
JWT_EXPIRE_HOURS=12

# ---- 跨域来源（前端由 nginx / 本地静态服务同源反代，默认放开即可） ----
CORS_ORIGINS=*

# ---- 图片上传限制 ----
# MAX_IMAGE_BYTES=10485760
# MAX_IMAGE_COUNT=9

# ---- 种子数据脚本与种子图片（首次启动自动建表并注入） ----
SEED_SCRIPT=database/seed.py
SEED_IMAGE_DIR=database/seed_images
