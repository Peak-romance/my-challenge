{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://c10.local/schemas/kstar.schema.json",
  "title": "C10 KSTAR 四层记忆",
  "description": "K 知识与 A 归档为 JSONL 行记录；S 状态为单对象；T 轨迹为 JSONL 行记录（不可变）。",
  "definitions": {
    "knowledge": {
      "title": "K · Knowledge（语义层）",
      "type": "object",
      "required": ["id", "layer", "text", "importance", "created", "use_count", "status"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "pattern": "^k-\\d{8}-[0-9a-f]{6}$"},
        "layer": {"const": "K"},
        "kind": {"type": "string", "default": "fact", "examples": ["fact", "preference", "rule"]},
        "text": {"type": "string", "minLength": 1, "description": "一条独立成立的稳定结论"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "string", "description": "写入来源，如 run:run-20261115-ab12cd 或 cli"},
        "importance": {"type": "number", "minimum": 0, "maximum": 1, "description": "动态权重，随命中上浮、随闲置衰减"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "created": {"type": "string", "format": "date-time"},
        "last_used": {"type": "string", "format": "date-time"},
        "use_count": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "enum": ["active", "archived"]}
      }
    },
    "state": {
      "title": "S · State（情境层）",
      "type": "object",
      "required": ["session", "turns", "open_loops", "recent"],
      "additionalProperties": true,
      "properties": {
        "session": {"type": "string"},
        "turns": {"type": "integer", "minimum": 0},
        "created": {"type": "string", "format": "date-time"},
        "updated": {"type": "string", "format": "date-time"},
        "focus": {"type": "string", "description": "最近一次任务焦点，最多 120 字"},
        "last_task": {"type": "string"},
        "open_loops": {
          "type": "array",
          "maxItems": 12,
          "description": "未闭环事项；同文归一化去重（去空白 + 小写）",
          "items": {
            "type": "object",
            "required": ["id", "text", "created"],
            "properties": {
              "id": {"type": "string", "pattern": "^loop-\\d{8}-[0-9a-f]{6}$"},
              "text": {"type": "string", "minLength": 1},
              "created": {"type": "string", "format": "date-time"}
            }
          }
        },
        "recent": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["ts", "task", "run_id"],
            "properties": {
              "ts": {"type": "string", "format": "date-time"},
              "task": {"type": "string", "maxLength": 120},
              "run_id": {"type": "string"}
            }
          }
        },
        "_recovered": {"type": "boolean", "description": "状态文件损坏后重建的标记"}
      }
    },
    "lesson": {
      "title": "A · Archive（归档/复盘层，R=Reflection）",
      "type": "object",
      "required": ["id", "layer", "kind", "text", "evidence", "action", "importance", "created", "status"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "pattern": "^a-\\d{8}-[0-9a-f]{6}$"},
        "layer": {"const": "A"},
        "kind": {
          "type": "string",
          "enum": ["success", "failure", "gap", "weak_skill", "recall_miss", "preference"]
        },
        "text": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "必须指向 T 层 run_id，保证教训可查证"
        },
        "action": {"type": "string", "description": "可执行的下一步，禁止写『下次注意』"},
        "importance": {"type": "number", "minimum": 0, "maximum": 1},
        "created": {"type": "string", "format": "date-time"},
        "last_used": {"type": "string", "format": "date-time"},
        "use_count": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "enum": ["active", "archived"]}
      }
    },
    "trace": {
      "title": "T · Trajectory（轨迹层）",
      "description": "见 schemas/trace.schema.json；此处仅声明层名以保持四层对齐。",
      "type": "object",
      "required": ["run_id", "ts", "task"],
      "properties": {
        "run_id": {"type": "string"},
        "ts": {"type": "string", "format": "date-time"},
        "task": {"type": "string"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/definitions/knowledge"},
    {"$ref": "#/definitions/state"},
    {"$ref": "#/definitions/lesson"},
    {"$ref": "#/definitions/trace"}
  ]
}
